            </div>
            <div className="input-group">
              <label className="input-label" htmlFor="scaler">Feature Scaling</label>
              <select id="scaler" className="input-field" value={scaler} onChange={e => setScaler(e.target.value)}>
                <option value="standard">Standard Scaler (Z-score)</option>
                <option value="minmax">Min-Max Normalization</option>
                <option value="robust">Robust Scaler</option>
                <option value="none">No Scaling</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </>
  )
}

/* ── STEP 2 — Model ──────────────────────── */
function ModelPanel({ registeredModels, selected, onSelect }) {
  const model = AVAILABLE_ALGORITHMS.find(a => a.id === selected)
  const registered = registeredModels.find(m => m.id === selected)
  const active = model || registered
  const [params, setParams] = useState(active?.params || {})

  useEffect(() => {
    const a = AVAILABLE_ALGORITHMS.find(a => a.id === selected)
    const r = registeredModels.find(m => m.id === selected)
    const m = a || r
    if (m) setParams({ ...m.params })
  }, [selected, registeredModels])

  return (
    <>
      {/* Available Algorithms */}
      <div className="panel anim">
        <div className="panel-header">
          <div className="panel-title-row">
            <div className="panel-icon">🤖</div>
            <div>
              <div className="panel-title">Available Algorithms</div>
              <div className="panel-subtitle">Select an algorithm to configure and train</div>
            </div>
          </div>
          {selected && (
            <span className="panel-badge badge-blue">{active?.name}</span>
          )}
        </div>
        <div className="panel-body">
          <div className="model-grid">
            {AVAILABLE_ALGORITHMS.map(a => (
              <div
                key={a.id}
                id={`model-${a.id}`}
                className={`model-card${selected === a.id ? ' selected' : ''}`}
                onClick={() => onSelect(a.id)}
                role="radio"
                aria-checked={selected === a.id}
                tabIndex={0}
                onKeyDown={e => e.key === 'Enter' && onSelect(a.id)}
              >
                <div className="model-card-top">
                  <div className="model-emoji" style={{ background: MODEL_ICON_BG[a.id] }}>{a.icon}</div>
                  <div className="radio-circle">
                    <div className="radio-dot" />
                  </div>
                </div>
                <div className="model-name">{a.name}</div>
                <div className="model-type">{a.type}</div>
                <div className="model-desc">{a.desc}</div>
                <div className="model-stats">
                  <div className="model-stat">
                    <div className="model-stat-val" style={{ fontSize: 10 }}>{a.stats.speed}</div>
                    <div className="model-stat-lbl">Speed</div>
                  </div>
                  <div className="model-stat">
                    <div className="model-stat-val" style={{ fontSize: 10 }}>{a.stats.memory}</div>
                    <div className="model-stat-lbl">Memory</div>
                  </div>
                  <div className="model-stat">
                    <div className="model-stat-val" style={{ fontSize: 10 }}>Train</div>
                    <div className="model-stat-lbl">Action</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Registered Models from MLflow */}
      {registeredModels.length > 0 && (
        <div className="panel anim d1">
          <div className="panel-header">
            <div className="panel-title-row">
              <div className="panel-icon">📦</div>
              <div>
                <div className="panel-title">Registered Models</div>
                <div className="panel-subtitle">Models trained and registered in MLflow</div>
              </div>
            </div>
            <span className="panel-badge badge-green">{registeredModels.length} registered</span>
          </div>
          <div className="panel-body">
            <div className="dataset-list">
              {registeredModels.map(m => (
                <div key={m.id} className="dataset-item" style={{ cursor: 'default' }}>
                  <div className="ds-icon">{m.icon || '🤖'}</div>
                  <div className="ds-info">
                    <div className="ds-name">{m.name}</div>
                    <div className="ds-meta">Accuracy: {m.displayAccuracy} · Created: {new Date(m.created_at).toLocaleDateString()}</div>
                  </div>
                  <span className="badge badge-blue">MLflow</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* Hyperparameters */}
      {selected && active && Object.keys(params).length > 0 && (
        <div className="panel anim d2">
          <div className="panel-header">
            <div className="panel-title-row">
              <div className="panel-icon">🔧</div>
              <div>
                <div className="panel-title">Hyperparameters</div>
                <div className="panel-subtitle">{active.name} — tune training parameters</div>
              </div>
            </div>
          </div>
          <div className="panel-body">
            <div className="hyperparam-grid">
              {Object.entries(params).map(([k, v]) => (
                <div key={k} className="input-group">
                  <label className="input-label" htmlFor={`hp-${k}`}>{k.replace(/_/g, ' ')}</label>
                  <input id={`hp-${k}`} className="input-field" type="text" value={v}
                    onChange={e => setParams(p => ({ ...p, [k]: e.target.value }))} />
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </>
  )
}

