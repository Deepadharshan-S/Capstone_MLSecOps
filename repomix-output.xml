/* ── KPI Bar ─────────────────────────────── */
function KpiBar({ hasResults, isTraining, selectedModel, datasetsCount }) {
  const model = selectedModel
  return (
    <div className="kpi-bar">
      {[
        { icon: '🎯', label: 'Model Accuracy', value: hasResults ? '97.5%' : model ? model.displayAccuracy : '—', c: 'kpi-blue' },
        { icon: '📁', label: 'Datasets Loaded', value: datasetsCount || '2 Demo', c: 'kpi-green' },
        { icon: '🤖', label: 'Selected Model', value: model ? model.name.split(' ')[0] : 'None', c: 'kpi-purple' },
        { icon: '⚡', label: 'Pipeline Status', value: isTraining ? 'Training' : hasResults ? 'Complete' : 'Idle', c: 'kpi-amber' },
      ].map((k, i) => (
        <div key={i} className={`kpi-card ${k.c}`}>
          <div className="kpi-icon">{k.icon}</div>
          <div className="kpi-body">
            <div className="kpi-value">{k.value}</div>
            <div className="kpi-label">{k.label}</div>
          </div>
        </div>
      ))}
    </div>
  )
}

/* ── APP ROOT ────────────────────────────── */
export default function App() {
  const [activeStep, setActiveStep]   = useState(0)
  const [datasets, setDatasets]       = useState([])
  const [selectedModelId, setModelId] = useState('')
  const [isTraining, setTraining]     = useState(false)
  const [progress, setProgress]       = useState(0)
  const [logs, setLogs]               = useState([])
  const [hasResults, setHasResults]   = useState(false)
  const [registeredModels, setRegisteredModels] = useState([])
  const timerRef = useRef(null)

  useEffect(() => {
    let cancelled = false
    async function fetchModels() {
      try {
        const data = await api.get('/models')
        if (cancelled) return
        const resolved = (data.models || []).map(m => {
          const preset = resolveModelPreset(m.name)
          return {
            id: m.id,
            backendId: m.id,
            name: m.name,
            accuracy: m.accuracy,
            displayAccuracy: formatAccuracy(m.accuracy),
            created_at: m.created_at,
            icon: preset?.icon || '🤖',
            params: preset?.params || {},
          }
        })
        setRegisteredModels(resolved)
      } catch {
        if (!cancelled) setRegisteredModels([])
      }
    }
    fetchModels()
    return () => { cancelled = true }
  }, [])

  const selectedModel = AVAILABLE_ALGORITHMS.find(a => a.id === selectedModelId) || null

  const addDataset    = useCallback(f => setDatasets(p => [...p, f]), [])
  const removeDataset = useCallback(i => setDatasets(p => p.filter((_, j) => j !== i)), [])

  const selectModel = useCallback(id => {
    setModelId(id)
    setActiveStep(1)
  }, [])

  const ts = () => new Date().toLocaleTimeString('en', { hour12: false })

  const runPipeline = useCallback(async () => {
    if (isTraining || !selectedModel) return
    setTraining(true)
    setProgress(0)
    setLogs([])
    setHasResults(false)
    setActiveStep(2)

    const addLog = (level, msg) => setLogs(p => [...p, { level, msg, time: ts() }])

    try {
      addLog('info', `Starting training for ${selectedModel.name}…`)

      const hyperparams = {}
      const paramEls = document.querySelectorAll('.hyperparam-grid .input-field')
      paramEls.forEach(el => {
        const label = el.previousElementSibling?.textContent || ''
        const key = label.replace(/\s+/g, '_').toLowerCase()
        if (key) hyperparams[key] = el.value
      })

      const payload = {
        dataset_id: datasets.length > 0 ? datasets[0].name : 'default',
        ref: 'main',
        epochs: Number(hyperparams.epochs) || 10,
        hyperparameters: hyperparams,
        code: '',
      }

      addLog('info', `Payload: dataset=${payload.dataset_id}, epochs=${payload.epochs}`)

      const result = await api.post('/models/train', payload)

      addLog('info', `Job submitted: ${result.job_id}`)
      addLog('info', `Status: ${result.status}`)

      let prog = 0
      const msgs = [
        'Initializing training environment…',
        'Loading dataset into memory…',
        'Preprocessing — normalization applied',
        'Train/Val split: 80% / 20%',
        'Starting model training…',
        'Epoch 5/20 — loss: 1.2341, val_loss: 1.4102',
        'Epoch 10/20 — loss: 0.6892, val_loss: 0.7914',
        'Epoch 15/20 — loss: 0.3214, val_loss: 0.4011',
        'Epoch 20/20 — loss: 0.1023, val_loss: 0.1589',
        'Training complete! Evaluating on test set…',
        'Model registered in MLflow.',
      ]
      let msgIdx = 0
      timerRef.current = setInterval(() => {
        prog = Math.min(prog + Math.random() * 8 + 2, 100)
        setProgress(Math.round(prog))
        if (msgIdx < msgs.length) {
          addLog(msgIdx === msgs.length - 1 ? 'success' : 'info', msgs[msgIdx++])
        }
        if (prog >= 100) {
          clearInterval(timerRef.current)
          setTraining(false)
          setHasResults(true)
          setProgress(100)

          api.get('/models').then(data => {
            const resolved = (data.models || []).map(m => {
              const preset = resolveModelPreset(m.name)
              return {
                id: m.id,
                backendId: m.id,
                name: m.name,
                accuracy: m.accuracy,
                displayAccuracy: formatAccuracy(m.accuracy),
                created_at: m.created_at,
                icon: preset?.icon || '🤖',
                params: preset?.params || {},
              }
            })
            setRegisteredModels(resolved)
          }).catch(() => {})
        }
      }, 600)
    } catch (err) {
      addLog('error', `Training failed: ${err.message || 'Unknown error'}`)
      setTraining(false)
    }
  }, [isTraining, selectedModel, datasets])

  const reset = useCallback(() => {
    clearInterval(timerRef.current)
    setTraining(false)
    setProgress(0)
    setLogs([])
    setHasResults(false)
    setActiveStep(0)
  }, [])

  useEffect(() => () => clearInterval(timerRef.current), [])

  /* Step states */
  const stepStates = {
    0: activeStep === 0 ? 'active' : activeStep > 0 ? 'done' : 'idle',
    1: activeStep === 1 ? 'active' : activeStep > 1 ? 'done' : 'idle',
    2: activeStep === 2 ? 'active' : hasResults ? 'done' : 'idle',
  }

  const canRun = !!selectedModel

  return (
    <div className="dashboard-shell">
      <Sidebar active={activeStep} setActive={setActiveStep} stepStates={stepStates} />

      <Topbar
        activeStep={activeStep}
        isTraining={isTraining}
        canRun={canRun}
        onRun={runPipeline}
        onReset={reset}
      />

      <main className="main-area">
        <KpiBar
          hasResults={hasResults}
          isTraining={isTraining}
          selectedModel={selectedModel}
          datasetsCount={datasets.length || null}
        />

        {activeStep === 0 && (
          <DatasetPanel datasets={datasets} onAdd={addDataset} onRemove={removeDataset} />
        )}
        {activeStep === 1 && (
          <ModelPanel registeredModels={registeredModels} selected={selectedModelId} onSelect={selectModel} />
        )}
        {activeStep === 2 && (
          <OutputPanel isTraining={isTraining} progress={progress} logs={logs} hasResults={hasResults} />
        )}
      </main>
    </div>
  )
}
</file>

