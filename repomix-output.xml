<file path="frontend/src/auth/LoginPage.css">
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-base, #f8f9fb);
  padding: 24px;
}

.auth-card {
  width: 100%;
  max-width: 380px;
  background: var(--bg-surface, #ffffff);
  border: 1px solid var(--border, rgba(0, 0, 0, 0.08));
  border-radius: 14px;
  padding: 32px 28px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
}

.auth-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  font-size: 15px;
  font-weight: 600;
  color: var(--text-100, #1e293b);
}

.auth-logo {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: var(--accent-500, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: white;
}

.auth-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text-100, #1e293b);
  margin: 0 0 4px;
}

.auth-subtitle {
  font-size: 13px;
  color: var(--text-400, #64748b);
  margin: 0 0 20px;
}

.auth-alert {
  font-size: 13px;
  padding: 10px 12px;
  border-radius: 8px;
  margin-bottom: 16px;
  line-height: 1.4;
}

.auth-alert-error {
  background: rgba(239, 68, 68, 0.08);
  color: #dc2626;
  border: 1px solid rgba(239, 68, 68, 0.2);
}

.auth-alert-ok {
  background: rgba(16, 185, 129, 0.08);
  color: #059669;
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.auth-field {
  display: block;
  margin-bottom: 16px;
}

.auth-field span {
  display: block;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-200, #475569);
  margin-bottom: 6px;
}

.auth-field input {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-input, #f8f9fb);
  border: 1px solid var(--border, rgba(0, 0, 0, 0.12));
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  color: var(--text-100, #1e293b);
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.auth-field input:focus {
  border-color: var(--accent-500, #3b82f6);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  background: #ffffff;
}

.auth-password-hints {
  list-style: none;
  padding: 0;
  margin: -8px 0 16px;
  font-size: 11.5px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px 8px;
}

.auth-password-hints li.unmet {
  color: var(--text-400, #94a3b8);
}

.auth-password-hints li.met {
  color: #10b981;
}

.auth-submit {
  width: 100%;
  padding: 11px;
  border-radius: 8px;
  border: none;
  background: var(--accent-500, #3b82f6);
  color: white;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.15s ease, background 0.15s ease;
}

.auth-submit:hover:not(:disabled) {
  background: #2563eb;
}

.auth-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.auth-switch {
  display: block;
  width: 100%;
  margin-top: 16px;
