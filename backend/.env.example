# MLSecOps Application Configuration Template
# Copy this file to .env and configure the variables accordingly.

APP_NAME="MLSecOps"
APP_VERSION="0.1.0"
DEBUG=true

HOST="0.0.0.0"
PORT=8000

# Database Configuration (either provide DATABASE_URL or individual POSTGRES_* vars)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlsecops"

# Or configure PostgreSQL separately:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=mlsecops
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Security Configuration
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your-super-secure-jwt-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# lakeFS Configuration
LAKEFS_ENDPOINT="http://localhost:8000"
LAKEFS_ACCESS_KEY_ID="your-lakefs-access-key-id"
LAKEFS_SECRET_ACCESS_KEY="your-lakefs-secret-access-key"
LAKEFS_DEFAULT_BRANCH="main"

