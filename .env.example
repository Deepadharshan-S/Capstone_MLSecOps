# ==============================================================================
# Capstone SentinelML Environment Variables Template
# ==============================================================================

# Application Settings
APP_NAME="SentinelML"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# Database Settings (Postgres Container)
POSTGRES_USER=sentinelml
POSTGRES_PASSWORD=sentinelml123
POSTGRES_DB=sentinelml
DATABASE_URL=postgresql+psycopg://sentinelml:sentinelml123@localhost:5432/sentinelml

# Production Admin Provisioning (used by seed_db.py in production)
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_USERNAME="admin_user"
# SEED_ADMIN_EMAIL="admin@sentinelml.com"

# Security Keys
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your-super-secure-jwt-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_CLEANUP_INTERVAL_SECONDS=3600
TOKEN_CLEANUP_ENABLED=true

# Threat Hunting & Detection Engine Background Task
DETECTION_ENGINE_INTERVAL_SECONDS=30
DETECTION_ENGINE_ENABLED=true
INFERENCE_BURST_WINDOW_SECONDS=60
INFERENCE_BURST_THRESHOLD=50

# MinIO Settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Least-privilege MinIO application access keys (required in production):
# MINIO_ACCESS_KEY=""
# MINIO_SECRET_KEY=""
MINIO_ENDPOINT=http://localhost:9000
# MINIO_INTERNAL_ENDPOINT=""
MINIO_STORAGE_MUTATION_DETECTION_ENABLED=true
MINIO_WEBHOOK_SECRET="sentinelml-dev-minio-webhook-secret-32b"
# LAKEFS_S3_ACCESS_KEY_ID=""

# lakeFS Settings
LAKEFS_DATABASE_POSTGRES_CONNECTION_STRING=postgres://sentinelml:sentinelml123@sentinelml-postgres:5432/lakefs?sslmode=disable
LAKEFS_AUTH_ENCRYPT_SECRET_KEY="your-lakefs-auth-encryption-key-change-this"
# lakeFS is published on host port 8000 by docker-compose.yml; the backend runs on host, use localhost.
LAKEFS_ENDPOINT=http://localhost:8000
# LAKEFS_INTERNAL_ENDPOINT=""
LAKEFS_ACCESS_KEY_ID="your-lakefs-access-key-id"
LAKEFS_SECRET_ACCESS_KEY="your-lakefs-secret-access-key"
LAKEFS_DEFAULT_BRANCH=main
LAKEFS_BLOCKSTORE_BUCKET=lakefs
LAKEFS_WEBHOOK_URL="http://host.docker.internal:8001/api/webhooks/lakefs/data-validation"
LAKEFS_WEBHOOK_SECRET="sentinelml-dev-webhook-secret-key-32b"

# Statistical Poisoning Gate Settings
POISONING_DETECTION_ENABLED=true
POISONING_KS_ALPHA=0.01
POISONING_KS_D_THRESHOLD=0.15
POISONING_CHI2_ALPHA=0.01
POISONING_PSI_THRESHOLD=0.25
POISONING_MAX_FILE_SIZE_BYTES=52428800
POISONING_MAX_SAMPLE_ROWS=50000
POISONING_ALLOW_NEW_COLUMNS=false
POISONING_ALLOW_NEW_DATASET_FILES=false
POISONING_ALLOW_QUERY_PARAM_AUTH=false

# MLflow Tracking & S3 storage Config
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_INTERNAL_ENDPOINT=""
MLFLOW_ARTIFACT_BUCKET=mlflow
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_S3_IGNORE_TLS=true

# CORS allow-list (comma-separated browser origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Ray Training Sandboxing & Kubernetes Configuration
ALLOW_LOCAL_RAY_FALLBACK=false
MAX_CONCURRENT_RAYJOBS=2
RAYJOB_CONCURRENCY_TIMEOUT_SECONDS=300.0
KUBERNETES_NAMESPACE=default
RAY_IMAGE="sentinelml-ray:latest"
# RAY_SERVE_HTTP_ENDPOINT=""

# Optional: Dedicated least-privilege training service credentials
# If omitted, MinIO STS assume_role generates temporary 1-hour session credentials for s3://mlflow.
# MINIO_TRAINING_ACCESS_KEY_ID=""
# MINIO_TRAINING_SECRET_ACCESS_KEY=""
# LAKEFS_TRAINING_ACCESS_KEY_ID=""
# LAKEFS_TRAINING_SECRET_ACCESS_KEY=""

# OpenTelemetry Observability Configuration (Phase 5)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sentinelml-backend
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_INTERNAL_ENDPOINT=""
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=5
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_EXPORT_INTERVAL_MS=15000
OTEL_EXCLUDED_URLS=health

# Grafana administrator credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me


